# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — anywhere in the workspace
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — anywhere
**/.next/
**/out/

# build
**/dist/
**/build/

# misc
.DS_Store
*.pem
.agents

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript incremental build cache — stale entries cause spurious
# "cannot find module" errors after dep changes, so never commit them.
*.tsbuildinfo
**/tsconfig.tsbuildinfo
**/next-env.d.ts

# prisma — anywhere
**/prisma/*.db
**/prisma/*.db-journal
**/prisma/generated/

# swc / turbo caches
.swc/
.turbo/

# Indox test corpus — local-only repos + exports for indexing
/test-corpus/

# Generated by Vercel `workflow` runtime when running `npx skills experimental_install`.
# These are build artifacts and must not be committed — they import `workflow/runtime`
# which isn't a dependency of this repo, so any commit of them breaks the Next build.
**/app/.well-known/workflow/

# XMCP build artifacts
packages/mcp/.xmcp

# Storybook
packages/ui/storybook-static

# Evals
evals/runs/