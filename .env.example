# ─── Database ────────────────────────────────────────────────────────────────
# Postgres connection string. pgvector and pg_trgm extensions must be available:
#   CREATE EXTENSION vector;
#   CREATE EXTENSION pg_trgm;
DATABASE_URL=postgresql://user:password@host:5432/indox

# Optional. Only needed if DATABASE_URL points at a transaction-pooler that
# strips LISTEN/NOTIFY (Neon's pooled URL, raw PgBouncer in transaction mode,
# Supavisor). pg-boss requires LISTEN/NOTIFY, so it falls back here when set.
# Leave unset on Railway, RDS, or any direct connection.
# DATABASE_URL_UNPOLLED=postgresql://user:password@direct-host:5432/indox

# ─── OpenAI ─────────────────────────────────────────────────────────────────
# Used for chat completions and `text-embedding-3-small` at index time.
OPENAI_API_KEY=sk-...

# ─── Auth (better-auth) ─────────────────────────────────────────────────────
# Secret for signing session cookies. Generate with `openssl rand -hex 32`.
# Rotating this invalidates every existing session.
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-hex-32

# Canonical URL of this deployment. Used as the OAuth/redirect origin and
# included in session cookies. No trailing slash.
BETTER_AUTH_URL=http://localhost:3000

# Optional: lock signup down to specific addresses. Comma-separated.
# Leave empty for open signup (the right default for personal/dev use).
# INDOX_ALLOWED_EMAILS=alice@example.com,bob@example.com

# ─── Adapter token encryption ───────────────────────────────────────────────
# At-rest encryption key for `adapters.token` (GitHub PATs, etc.). Generate
# with `openssl rand -hex 32`. Must be ≥16 chars. Rotating this invalidates
# all previously encrypted tokens — keep it stable.
ADAPTER_TOKEN_KEY=replace-me-with-openssl-rand-hex-32

# ─── CSRF ───────────────────────────────────────────────────────────────────
# Comma-separated origins to accept on mutating routes in addition to the
# request's own origin. Leave blank unless the web app sits behind a
# different public hostname than the one users browse to.
# CSRF_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com

# ─── MCP ────────────────────────────────────────────────────────────────────
# Public URL of the MCP server (the third Railway service). Shown to users
# on /dashboard/mcp as the value they paste into Cursor/Claude.
MCP_PUBLIC_URL=http://localhost:3030/mcp

# ─── Rate limiting (optional) ───────────────────────────────────────────────
# Upstash Redis credentials power the chat rate limiter. With neither set
# the limiter is a no-op (safe for local dev, not for public deployment).
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
