generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

// An Adapter is a configured connection to an external data source
// (GitHub, Confluence, …). It owns credentials and a scope describing
// what to ingest. Each adapter exposes one or more Sources.
model Adapter {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  kind          String    // "github" | "confluence" | …
  authIdentity  String?   @map("auth_identity")  // e.g. Confluence email; null for GitHub PAT
  // AES-256-GCM ciphertext prefixed with `enc:v1:` (see core/src/crypto.ts).
  // Legacy plaintext values are still readable for one release.
  token         String
  scope         Json                                  // adapter-specific, see core/src/adapters
  lastSyncedAt  DateTime? @map("last_synced_at")
  syncStatus    String?   @map("sync_status")          // "idle" | "running" | "ready" | "failed"
  syncError     String?   @map("sync_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sources       Source[]

  @@index([workspaceId])
  @@map("adapters")
}

// A Source is a single indexable thing inside an Adapter: a GitHub repo,
// a Confluence space, etc. The Adapter's enumerate step creates Sources;
// the index step fills Embeddings for each Source.
model Source {
  id            String    @id @default(cuid())
  adapterId     String    @map("adapter_id")
  kind          String                                // mirrors Adapter.kind for fast filtering
  externalId    String    @map("external_id")         // e.g. "owner/name" or "SPACEKEY"
  displayName   String    @map("display_name")
  metadata      Json?                                  // sha for git, version for confluence, …
  indexStatus   String?   @map("index_status")        // "idle" | "running" | "ready" | "failed"
  indexedAt     DateTime? @map("indexed_at")
  indexError    String?   @map("index_error")
  chunkCount    Int?      @map("chunk_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  adapter       Adapter   @relation(fields: [adapterId], references: [id], onDelete: Cascade)
  embeddings    Embedding[]

  @@unique([adapterId, externalId])
  @@index([adapterId])
  @@map("sources")
}

model Embedding {
  id           Int                          @id @default(autoincrement())
  sourceId     String                       @map("source_id")
  chunkText    String                       @map("chunk_text")
  chunkUrl     String?                      @map("chunk_url")
  embedding    Unsupported("halfvec(3072)")?
  // Generated column (STORED) — populated by Postgres from chunk_text.
  // Queried via raw SQL for hybrid retrieval; never written from app code.
  chunkTextTsv Unsupported("tsvector")?     @map("chunk_text_tsv")

  source       Source                       @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@map("embeddings")
}

// Chat history. Scoped to a workspace and to a user within it — for Tier 1
// these are always the workspace owner, but the userId column is here from
// the start so per-member private history works without a migration when
// Tier 2 (shared workspaces) ships.
//
// Anonymous embed sessions (public /w/<slug> chat) set anonSessionId instead
// of userId. Both are nullable so either variant can exist; exactly one of
// the two is always present on a real row.
model Conversation {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  userId        String?  @map("user_id")          // null for anonymous embed sessions
  anonSessionId String?  @map("anon_session_id")  // UUID minted client-side for embed visitors
  title         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ConversationMessage[]

  @@index([workspaceId, userId, updatedAt])
  @@index([workspaceId, anonSessionId, updatedAt])
  @@map("conversations")
}

// One row per UIMessage — `parts` stores the AI SDK's parts array verbatim so
// reload reconstructs tool calls, search results, and text exactly as the
// user saw them mid-session.
model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String   // "user" | "assistant" | "system" | "tool"
  parts          Json
  createdAt      DateTime @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

model UsageLog {
  ip         String
  date       DateTime @default(now())
  queryCount Int      @default(0) @map("query_count")

  @@id([ip, date])
  @@map("usage_log")
}

// ─── Auth ────────────────────────────────────────────────────────────────
// Tables managed by better-auth (https://better-auth.com). Field names use
// camelCase here because better-auth's Prisma adapter reads them that way;
// the actual SQL columns are lowercased via @map where noted.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  accounts      Account[]
  workspaces    Workspace[]
  workspaceTokens WorkspaceToken[]
  conversations Conversation[]

  @@map("users")
}

// A Workspace is a tenant boundary: it groups adapters, sources, MCP tokens,
// and chat history. Today each workspace has exactly one owner (Tier 1).
// When shared workspaces ship, a separate WorkspaceMember join table is added
// — purely additive, no migration of existing rows.
model Workspace {
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id")
  name      String
  // Stable URL-safe identifier. Unique globally so /w/<slug> routes don't
  // need an owner segment. Owner can change this from settings.
  slug      String   @unique
  // When true, /w/<slug> serves chat to anonymous visitors. The chat route
  // skips the session check and rate-limits per (workspaceId, ip).
  isPublic  Boolean  @default(false) @map("is_public")
  // AES-256-GCM ciphertext prefixed with `enc:v1:` (see core/src/crypto.ts).
  // When set on a public workspace, chat completions hit OpenAI with this
  // key instead of the platform key. Null = use platform key (with a much
  // stricter rate limit).
  openaiApiKeyEncrypted String? @map("openai_api_key_encrypted")
  // Chat completion model. Validated in app against a small allowlist;
  // non-default values require BYO key on a public workspace.
  model     String   @default("gpt-4o-mini")
  // Hard daily ceiling on chat calls for this workspace, counted across
  // all callers. Owner can raise/lower from settings.
  dailyCallLimit Int @default(200) @map("daily_call_limit")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner         User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  adapters      Adapter[]
  conversations Conversation[]
  usage         WorkspaceUsage[]

  @@index([ownerId])
  @@map("workspaces")
}

// Daily call counters per (workspace, ip). Used to enforce dailyCallLimit
// and per-ip throttles on public workspaces. Old rows can be pruned by a
// cron job; the schema doesn't enforce TTL.
model WorkspaceUsage {
  workspaceId String   @map("workspace_id")
  ip          String
  date        DateTime @db.Date
  count       Int      @default(0)

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, ip, date])
  @@index([workspaceId, date])
  @@map("workspace_usage")
}

// A bearer token a user copies into their MCP client config. Replaces the
// previous `User.mcpToken` column. A token implicitly grants access to every
// workspace the issuing user owns; setting `workspaceIds` narrows it to a
// subset (future scoping feature, the schema is ready). Stored plaintext for
// O(1) lookup on every MCP call — see the rationale in the old mcp-token.ts.
model WorkspaceToken {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  token        String   @unique
  label        String?
  // Empty array = "all workspaces this user owns". Non-empty = restrict to
  // these workspace ids. The MCP resolver enforces the user-ownership check
  // on top, so a token can never reach a workspace its issuer doesn't own.
  workspaceIds String[] @default([]) @map("workspace_ids")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("workspace_tokens")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}
