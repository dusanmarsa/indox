{
  "name": "@indox/core",
  "version": "0.2.0",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db.ts",
    "./logger": "./src/logger.ts",
    "./crypto": "./src/crypto.ts",
    "./queue": "./src/queue.ts",
    "./search": "./src/search/hybrid.ts",
    "./search/rrf": "./src/search/rrf.ts",
    "./sources": "./src/source-index.ts",
    "./conversations": "./src/conversations.ts",
    "./mcp-token": "./src/mcp-token.ts",
    "./workspaces": "./src/workspaces.ts",
    "./workspace-settings": "./src/workspace-settings.ts",
    "./workspace-rate-limit": "./src/workspace-rate-limit.ts",
    "./adapters": "./src/adapters/registry.ts",
    "./adapters/types": "./src/adapters/types.ts",
    "./adapters/github": "./src/adapters/github.ts",
    "./adapters/notion": "./src/adapters/notion.ts",
    "./sync": "./src/sync.ts"
  },
  "scripts": {
    "lint": "bunx --bun prettier --write . --ignore-path ../../.prettierignore && bunx --bun eslint --fix .",
    "typecheck": "bunx --bun tsc --noEmit",
    "db:reset": "bunx --bun --env-file=../../.env prisma migrate reset",
    "db:migrate": "bunx --bun --env-file=../../.env prisma migrate dev",
    "db:push": "bunx --bun --env-file=../../.env prisma db push",
    "db:studio": "bunx --bun --env-file=../../.env prisma studio",
    "db:generate": "bunx --bun prisma generate"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.63",
    "@notionhq/client": "^5.21.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "ai": "6.0.180",
    "dotenv": "^17.2.4",
    "fflate": "^0.8.2",
    "pg": "^8.20.0",
    "pg-boss": "^10.1.5",
    "prisma": "^7.8.0",
    "tree-sitter-wasms": "^0.1.13",
    "tsx": "^4.21.0",
    "web-tree-sitter": "0.22.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "eslint": "^9",
    "typescript": "^5",
    "typescript-eslint": "^8"
  },
  "ignoreScripts": [
    "@prisma/client"
  ]
}
