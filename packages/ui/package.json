{
  "name": "@indox/ui",
  "version": "0.2.0",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/globals.css",
    "./cn": "./src/cn.ts"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "ui:add": "bunx --bun shadcn@latest add",
    "lint": "bunx --bun prettier --write . --ignore-path ../../.prettierignore && bunx --bun eslint --fix .",
    "typecheck": "bunx --bun tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "streamdown": "^2.5.0"
  },
  "peerDependenciesMeta": {
    "streamdown": {
      "optional": true
    }
  },
  "devDependencies": {
    "streamdown": "^2.5.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "typescript-eslint": "^8",
    "@storybook/addon-a11y": "^8.5.0",
    "@storybook/addon-essentials": "^8.5.0",
    "@storybook/react": "^8.5.0",
    "@storybook/react-vite": "^8.5.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "shadcn": "^4.7.0",
    "storybook": "^8.5.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^6.0.0"
  }
}
